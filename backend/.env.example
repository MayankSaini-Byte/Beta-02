# KitchenSync backend environment
# Copy to .env and fill in what you need. Everything is optional - the API
# boots with sane defaults (persistent file store when no MONGO_URI is set).

# --- Persistence (pick ONE) ---
# MongoDB Atlas free tier SRV string, or local mongod:
MONGO_URI=mongodb://127.0.0.1:27017/kitchensync
# No MONGO_URI? The API auto-uses the persistent file store (db/kitchensync-store.json).

# --- Server ---
PORT=5000
JWT_SECRET=change-me-in-production
JWT_EXPIRES=7d

# --- Vision model service (Python/FastAPI in ../model-service) ---
# Leave empty to use the built-in z-ai vision fallback + honest failure cards.
MODEL_SERVICE_URL=http://127.0.0.1:8000
MODEL_TIMEOUT_MS=8000

# --- Load-cell weighing station (ESP32 firmware sends this in x-device-key) ---
DEVICE_KEY=secret-device-key
